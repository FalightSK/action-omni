# ── Large binary assets (never commit) ───────────────────────────────────────
# Ignore everything inside asset/ then whitelist .gitkeep placeholders only.
# New layout: asset/runs/<dataset>/<exp_id>/
asset/**
!asset/
!asset/runs/
!asset/runs/**/.gitkeep
!asset/dataset/
!asset/dataset/**/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# ── Environments ─────────────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs / temp ───────────────────────────────────────────────────────────────
/tmp/
*.log

# ── AI agent artifacts (never commit) ────────────────────────────────────────
# Claude Code memory, rules, and session files — not part of the codebase
.claude/
memory/
MEMORY.md
RULES.md
*.rules.md

# ── Derived / regenerable artifacts (do not commit) ──────────────────────────
# graphify knowledge-graph + AST cache (rebuild with: graphify update .)
graphify-out/
.graphify_*
# probe intermediate crops/scenes (regenerable from export_bank.py)
docs/experiments/**/_bank/
# rollout / overlay videos (large binaries)
docs/experiments/**/videos/
# debug / smoke overlays
docs/experiments/**/_proj_check.png
docs/experiments/**/_smoke_frame.png
