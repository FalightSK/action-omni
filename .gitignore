# ── Large binary assets (never commit) ───────────────────────────────────────
# Ignore everything inside asset/ then whitelist .gitkeep placeholders only.
# New layout: asset/runs/<dataset>/<exp_id>/
asset/**
!asset/
!asset/runs/
!asset/runs/**/.gitkeep
!asset/dataset/
!asset/dataset/**/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# ── Environments ─────────────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs / temp ───────────────────────────────────────────────────────────────
/tmp/
*.log
